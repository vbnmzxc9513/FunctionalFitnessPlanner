rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hosted trial usage and switches are maintained only by Admin SDK.
    match /aiTrialQuota/{document=**} {
      allow read, write: if false;
    }
    match /aiTrialConfig/{document=**} {
      allow read, write: if false;
    }
    function owner(userId) { return request.auth != null && request.auth.uid == userId; }
    function weekId(id) { return id.matches('^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$'); }
    function optionalNumber(data, field, min, max) {
      let value = data.get(field, null);
      return value == null || (value is number && value >= min && value <= max);
    }
    function validMetrics(data, id) {
      return data.keys().hasOnly(['date', 'height', 'weight', 'age', 'bodyFat', 'bmr', 'muscleLarm', 'muscleRarm', 'muscleLleg', 'muscleRleg', 'muscleTrunk'])
        && data.date == id && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && optionalNumber(data, 'height', 1, 300) && optionalNumber(data, 'weight', 1, 500)
        && optionalNumber(data, 'age', 1, 120) && (data.get('age', null) == null || data.age is int)
        && optionalNumber(data, 'bodyFat', 0, 100) && optionalNumber(data, 'bmr', 1, 10000)
        && optionalNumber(data, 'muscleLarm', 0, 100) && optionalNumber(data, 'muscleRarm', 0, 100)
        && optionalNumber(data, 'muscleLleg', 0, 150) && optionalNumber(data, 'muscleRleg', 0, 150)
        && optionalNumber(data, 'muscleTrunk', 0, 300);
    }
    function validProfile(data) {
      return data.keys().hasOnly(['difficultyLevel', 'isAnonymous'])
        && data.get('difficultyLevel', 1) is int && data.get('difficultyLevel', 1) >= 0 && data.get('difficultyLevel', 1) <= 2
        && data.get('isAnonymous', false) is bool;
    }
    function validDose(index) {
      let dose = request.resource.data.prescriptions[index];
      let id = dose.id;
      let rest = dose.restSeconds;
      let prep = dose.get('preparation', null);
      return dose.keys().hasOnly(['id', 'sets', 'value', 'unit', 'restSeconds', 'perSide', 'phase', 'preparation'])
        && id is string && id in request.resource.data.routine
        && dose.sets in [1, 2, 3, 4, 5]
        && dose.value.matches('^[0-9]{1,3}([–-][0-9]{1,3})?$')
        && dose.unit in ['reps', 'seconds', 'minutes', 'breaths']
        && rest is int && rest >= 0 && rest <= 300
        && dose.perSide is bool
        && dose.get('phase', 'legacy') in ['legacy', 'warmup', 'skill', 'strength', 'accessory', 'recovery', 'cooldown']
        && (prep == null || (prep.keys().hasOnly(['sets', 'value', 'unit', 'restSeconds', 'perSide', 'instruction'])
          && prep.sets in [1, 2] && prep.value.matches('^[0-9]{1,3}([–-][0-9]{1,3})?$')
          && prep.unit in ['reps', 'seconds', 'breaths']
          && prep.restSeconds is int && prep.restSeconds >= 0 && prep.restSeconds <= 120
          && prep.perSide is bool && prep.instruction is string && prep.instruction.size() <= 1000));
    }
    function validPrescriptions(day, part) {
      let doses = day.get('prescriptions', []);
      let count = doses.size();
      return doses is list && count <= 8 && (part == 1
        ? ((count < 1 || validDose(0)) && (count < 2 || validDose(1))
          && (count < 3 || validDose(2)) && (count < 4 || validDose(3)))
        : ((count < 5 || validDose(4)) && (count < 6 || validDose(5))
          && (count < 7 || validDose(6)) && (count < 8 || validDose(7))));
    }
    function validDay(day, expected, part) {
      return day is map && day.day == expected && day.routine is list && day.routine.size() <= 100
        && day.keys().hasOnly(['day', 'name', 'theme', 'concept', 'coachAdvice', 'routine', 'prescriptions', 'sessionType', 'warmupNote', 'cooldownNote', 'savedAt'])
        && validPrescriptions(day, part)
        && day.get('name', '') is string && day.get('theme', '') is string
        && day.get('concept', '') is string && day.get('coachAdvice', '') is string
        && day.get('sessionType', 'legacy') in ['legacy', 'training', 'recovery', 'rest']
        && day.get('warmupNote', '') is string && day.get('cooldownNote', '') is string;
    }
    function validPlanDay(data, id) {
      return data.savedAt == request.time
        && data.day is int && id.matches('^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])-D[1-5]-P[12]$')
        && id.matches('.*-D' + string(data.day) + '-P[12]$')
        && validDay(data, data.day, id.matches('.*-P1$') ? 1 : 2);
    }
    function validLegacyDose(dose, routine) {
      return dose is map && dose.keys().hasOnly(['id', 'sets', 'value', 'unit', 'restSeconds', 'perSide'])
        && dose.id is string && dose.id in routine
        && dose.sets is int && dose.sets >= 1 && dose.sets <= 5
        && dose.value is string && dose.value.matches('^[0-9]+([–-][0-9]+)?$') && dose.value.size() <= 9
        && dose.unit in ['reps', 'seconds', 'minutes', 'breaths']
        && dose.restSeconds is int && dose.restSeconds >= 0 && dose.restSeconds <= 300
        && dose.perSide is bool;
    }
    function validLegacyPrescriptions(day) {
      let doses = day.get('prescriptions', []);
      return doses is list && doses.size() <= 6
        && (doses.size() < 1 || validLegacyDose(doses[0], day.routine))
        && (doses.size() < 2 || validLegacyDose(doses[1], day.routine))
        && (doses.size() < 3 || validLegacyDose(doses[2], day.routine))
        && (doses.size() < 4 || validLegacyDose(doses[3], day.routine))
        && (doses.size() < 5 || validLegacyDose(doses[4], day.routine))
        && (doses.size() < 6 || validLegacyDose(doses[5], day.routine));
    }
    function validLegacyDay(day, expected) {
      return day is map && day.day == expected && day.routine is list && day.routine.size() <= 100
        && day.keys().hasOnly(['day', 'name', 'theme', 'concept', 'coachAdvice', 'routine', 'prescriptions'])
        && validLegacyPrescriptions(day)
        && day.get('name', '') is string && day.get('theme', '') is string
        && day.get('concept', '') is string && day.get('coachAdvice', '') is string;
    }
    function confirmedDay(day, expected, userId, appId, week) {
      let prefix = week + '-D' + string(expected);
      let first = getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/planDays/$(prefix + '-P1')).data;
      let second = getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/planDays/$(prefix + '-P2')).data;
      return day.day == expected && !('savedAt' in day)
        && first.savedAt == request.time && second.savedAt == request.time
        && first.diff(day).affectedKeys().hasOnly(['savedAt']) && second.diff(day).affectedKeys().hasOnly(['savedAt']);
    }
    function validWeeklyIntent(intent) {
      let keys = intent.keys();
      let targets = intent.targetRegions;
      let stiffness = intent.stiffnessRegions;
      let court = intent.badmintonDays;
      let time = intent.dailyTime;
      let date = intent.competitionDate;
      return intent is map && keys.hasAll(['focus', 'targetRegions', 'stiffnessRegions', 'badmintonDays', 'dailyTime', 'competitionDate'])
        && keys.hasOnly(['focus', 'targetRegions', 'stiffnessRegions', 'badmintonDays', 'dailyTime', 'competitionDate', 'weeklyExerciseIds', 'trainingDays'])
        && (!('trainingDays' in intent) || (intent.trainingDays is list && intent.trainingDays.size() <= 7 && intent.trainingDays.hasOnly([1, 2, 3, 4, 5, 6, 7]) && intent.trainingDays.toSet().size() == intent.trainingDays.size()))
        && (!('weeklyExerciseIds' in intent) || validWeeklyChoices(intent.weeklyExerciseIds))
        && intent.focus in ['balanced', 'strength', 'stability', 'coordination']
        && time is number && time >= 5 && time <= 240
        && targets is list && targets.size() <= 4 && targets.hasOnly(['legs', 'posterior', 'upper', 'core', 'serratus', 'scapular', 'rotator_cuff', 'chest', 'back', 'forearm', 'glutes', 'quadriceps', 'hamstrings', 'adductors', 'calves'])
        && targets.toSet().size() == targets.size()
        && stiffness is list && stiffness.size() <= 2 && stiffness.hasOnly(['hip', 'ankle', 'thoracic', 'shoulder'])
        && stiffness.toSet().size() == stiffness.size()
        && court is list && court.size() <= 7 && court.hasOnly([1, 2, 3, 4, 5, 6, 7])
        && date is string && (date == '' || date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function validWeeklyChoiceId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,100}$'); }
    function validWeeklyChoices(ids) {
      let count = ids.size();
      return ids is list && count <= 8 && ids.toSet().size() == count
        && (count < 1 || validWeeklyChoiceId(ids[0])) && (count < 2 || validWeeklyChoiceId(ids[1]))
        && (count < 3 || validWeeklyChoiceId(ids[2])) && (count < 4 || validWeeklyChoiceId(ids[3]))
        && (count < 5 || validWeeklyChoiceId(ids[4])) && (count < 6 || validWeeklyChoiceId(ids[5]))
        && (count < 7 || validWeeklyChoiceId(ids[6])) && (count < 8 || validWeeklyChoiceId(ids[7]));
    }
    function validPlan(data, userId, appId, week) {
      return data.keys().hasOnly(['conclusion', 'schedule', 'previous', 'source', 'baseDefault', 'language', 'revision', 'savedAt', 'validationVersion', 'weeklyIntent'])
        && (!('weeklyIntent' in data) || validWeeklyIntent(data.weeklyIntent))
        && data.conclusion is string && data.schedule is list && data.schedule.size() == 5
        && data.get('previous', {}) is map
        && data.get('revision', 0) is int && data.get('revision', 0) >= 0
        && data.get('validationVersion', 0) in [0, 1]
        && (data.get('validationVersion', 0) == 1
          ? (confirmedDay(data.schedule[0], 1, userId, appId, week)
          && confirmedDay(data.schedule[1], 2, userId, appId, week)
          && confirmedDay(data.schedule[2], 3, userId, appId, week)
          && confirmedDay(data.schedule[3], 4, userId, appId, week)
          && confirmedDay(data.schedule[4], 5, userId, appId, week))
          : (validLegacyDay(data.schedule[0], 1) && validLegacyDay(data.schedule[1], 2)
          && validLegacyDay(data.schedule[2], 3) && validLegacyDay(data.schedule[3], 4)
          && validLegacyDay(data.schedule[4], 5)));
    }
    function validProgress(data) {
      return data.keys().hasOnly(['completed', 'completedAt', 'exerciseTypes', 'scheduleSnapshot', 'totalExercises', 'difficultyBase', 'feedbackProvided', 'feedbackValue', 'schemaVersion'])
        && data.get('completed', {}) is map && data.get('completed', {}).size() <= 500
        && data.get('completed', {}).values().hasOnly([true, false])
        && data.get('completedAt', {}) is map && data.get('exerciseTypes', {}) is map
        && data.get('exerciseTypes', {}).values().hasOnly(['mobility', 'lower', 'core', 'upper_pull', 'upper_push', 'full', 'power'])
        && data.get('scheduleSnapshot', []) is list && data.get('scheduleSnapshot', []).size() <= 7
        && data.get('totalExercises', 0) is int && data.get('totalExercises', 0) >= 0 && data.get('totalExercises', 0) <= 500
        && data.get('difficultyBase', 1) in [0, 1, 2] && data.get('feedbackValue', 0) in [-1, 0, 1]
        && data.get('feedbackProvided', false) is bool && data.get('schemaVersion', 2) == 2;
    }
    function calendarDate(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && dateTimestamp(value).month() == int(value.split('-')[1]) && dateTimestamp(value).day() == int(value.split('-')[2]);
    }
    function dateTimestamp(value) {
      let parts = value.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }
    function currentDate(value) {
      // Calendar dates use the user's local timezone. UTC+14 is the latest
      // supported calendar day; client validation uses the actual local day.
      return calendarDate(value) && dateTimestamp(value) <= request.time + duration.value(14, 'h');
    }
    function requiredNullableNumber(data, field, min, max, integer) {
      return data[field] == null || ((integer ? data[field] is int : data[field] is number) && data[field] >= min && data[field] <= max);
    }
    function trainingUnitLimit(unit) { return unit == 'seconds' ? 3600 : (unit == 'minutes' ? 120 : 500); }
    function validActualSet(index, bound, whole) {
      let item = request.resource.data.sets[index];
      return item.keys().hasOnly(['value', 'otherSide'])
        && (whole ? item.value is int : item.value is number) && item.value >= 0 && item.value <= bound
        && (request.resource.data.perSide ? ((whole ? item.otherSide is int : item.otherSide is number) && item.otherSide >= 0 && item.otherSide <= bound) : item.otherSide == null);
    }
    function validActualSets(bound, whole) {
      let sets = request.resource.data.sets;
      let count = sets.size();
      return sets is list && count >= 1 && count <= 5
        && validActualSet(0, bound, whole) && (count < 2 || validActualSet(1, bound, whole))
        && (count < 3 || validActualSet(2, bound, whole)) && (count < 4 || validActualSet(3, bound, whole)) && (count < 5 || validActualSet(4, bound, whole));
    }
    function validActualSetsForUnit() {
      let unit = request.resource.data.unit;
      return unit == 'seconds' ? validActualSets(3600, false) : (unit == 'minutes' ? validActualSets(120, false) : validActualSets(500, true));
    }
    function validTargetRange(value, unit) {
      let parts = value.split('[–-]');
      let low = float(parts[0]);
      let high = parts.size() == 2 ? float(parts[1]) : low;
      return low >= 0.01 && high >= low && high <= trainingUnitLimit(unit)
        && (!(unit in ['reps', 'breaths']) || (low == int(low) && high == int(high)));
    }
    function validPlannedSnapshot() {
      let data = request.resource.data.planned;
      return data is map && data.keys().hasOnly(['sets', 'value', 'unit', 'perSide', 'phase', 'restSeconds'])
        && data.sets in [1, 2, 3, 4, 5] && data.value.matches('^[0-9]{1,4}([.][0-9]{1,3})?([–-][0-9]{1,4}([.][0-9]{1,3})?)?$')
        && data.unit in ['reps', 'seconds', 'minutes', 'breaths'] && validTargetRange(data.value, data.unit) && data.perSide is bool
        && data.phase in ['legacy', 'warmup', 'skill', 'strength', 'accessory', 'recovery', 'cooldown']
        && data.restSeconds is int && data.restSeconds >= 0 && data.restSeconds <= 300;
    }
    function validTrainingLog(id) {
      let data = request.resource.data;
      return data.keys().hasOnly(['week', 'day', 'exerciseId', 'date', 'variant', 'loadKg', 'loadBasis', 'resistanceLabel', 'unit', 'perSide', 'sets', 'rir', 'quality', 'symptoms', 'nextDay', 'planned', 'schemaVersion'])
        && weekId(data.week) && data.day in [1, 2, 3, 4, 5, 6, 7] && data.exerciseId.matches('^[A-Za-z0-9_-]{1,80}$')
        && id == data.week + '-D' + string(data.day) + '-' + data.exerciseId && currentDate(data.date)
        && data.schemaVersion == 1 && data.variant in ['bodyweight', 'dumbbell', 'cable', 'band', 'other']
        && requiredNullableNumber(data, 'loadKg', 0, 500, false) && data.loadBasis in ['none', 'per_dumbbell', 'total', 'stack', 'description']
        && data.resistanceLabel is string && data.resistanceLabel.size() <= 120
        && (data.loadBasis != 'none' || data.loadKg == null || data.loadKg == 0)
        && (data.variant != 'bodyweight' || data.loadBasis == 'none')
        && (data.loadBasis != 'description' || data.resistanceLabel.matches('.*[^ ].*'))
        && validActualSetsForUnit() && requiredNullableNumber(data, 'rir', 0, 10, true)
        && data.quality in ['good', 'unstable', 'unknown'] && data.symptoms in ['none', 'worse', 'unknown']
        && data.nextDay in ['pending', 'good', 'worse'] && (data.nextDay == 'pending' || dateTimestamp(data.date) + duration.value(1, 'd') <= request.time + duration.value(14, 'h')) && validPlannedSnapshot()
        && data.unit == data.planned.unit && data.perSide == data.planned.perSide;
    }
    function validReadiness(data, id) {
      return data.keys().hasOnly(['date', 'sleepHours', 'fatigue', 'soreness', 'symptoms', 'yesterdayCourtMinutes', 'yesterdayCourtRpe', 'todayCourtIntensity', 'schemaVersion'])
        && data.date == id && currentDate(id) && data.schemaVersion == 1
        && requiredNullableNumber(data, 'sleepHours', 0, 24, false)
        && requiredNullableNumber(data, 'fatigue', 0, 4, true) && requiredNullableNumber(data, 'soreness', 0, 4, true)
        && requiredNullableNumber(data, 'yesterdayCourtMinutes', 0, 360, true) && requiredNullableNumber(data, 'yesterdayCourtRpe', 0, 10, true)
        && data.symptoms in ['none', 'stable', 'worse', 'red_flags', 'unknown']
        && data.todayCourtIntensity in ['unknown', 'none', 'light', 'hard'];
    }
    // Date-native documents validate independently: a four-week commit uses
    // no rule document lookups and stays below both transaction budgets.
    function nativeDateIdentity(data, id) {
      let value = dateTimestamp(id);
      let day = value.dayOfWeek();
      let thursday = value + duration.value(4 - day, 'd');
      let week = int((thursday.dayOfYear() - 1) / 7) + 1;
      let weekString = string(thursday.year()) + '-W' + (week < 10 ? '0' : '') + string(week);
      return calendarDate(id) && data.date == id && data.day == day && data.week == weekString;
    }
    function boundedText(data, key, maximum) {
      return data[key] is string && data[key].size() <= maximum;
    }
    function validDateSession(data, id) {
      return data.keys().hasAll(['date', 'week', 'day', 'name', 'theme', 'concept', 'coachAdvice', 'routine', 'sessionType', 'warmupNote', 'cooldownNote', 'revision', 'periodId'])
        && data.keys().hasOnly(['date', 'week', 'day', 'name', 'theme', 'concept', 'coachAdvice', 'routine', 'sessionType', 'warmupNote', 'cooldownNote', 'revision', 'periodId', 'weeklyIntent'])
        && nativeDateIdentity(data, id) && data.day is int && data.day >= 1 && data.day <= 7
        && data.revision is int && data.revision >= 1
        && data.periodId is string && data.periodId.matches('^[A-Za-z0-9_-]{1,120}$')
        && validWeeklyChoices(data.routine)
        && data.sessionType in ['training', 'recovery', 'rest'] && ((data.sessionType == 'rest') == (data.routine.size() == 0))
        && boundedText(data, 'name', 1000) && boundedText(data, 'theme', 1000)
        && boundedText(data, 'concept', 4000) && boundedText(data, 'coachAdvice', 4000)
        && boundedText(data, 'warmupNote', 4000) && boundedText(data, 'cooldownNote', 4000)
        && (!('weeklyIntent' in data) || validWeeklyIntent(data.weeklyIntent));
    }
    function nativeDoseValue(value, maximum) {
      let parts = value.split('[–-]');
      let low = int(parts[0]);
      let high = parts.size() == 2 ? int(parts[1]) : low;
      return value is string && value.matches('^[0-9]{1,3}([–-][0-9]{1,3})?$') && low >= 1 && high >= low && high <= maximum;
    }
    function validNativePreparation(prep) {
      return prep is map && prep.keys().hasAll(['sets', 'value', 'unit', 'restSeconds', 'perSide', 'instruction'])
        && prep.keys().hasOnly(['sets', 'value', 'unit', 'restSeconds', 'perSide', 'instruction'])
        && prep.sets is int && prep.sets in [1, 2] && prep.unit in ['reps', 'seconds', 'breaths']
        && nativeDoseValue(prep.value, prep.unit == 'seconds' ? 30 : 8)
        && prep.restSeconds is int && prep.restSeconds >= 0 && prep.restSeconds <= 120
        && prep.perSide is bool && prep.instruction is string && prep.instruction.matches('.*[^ ].*') && prep.instruction.size() <= 1000;
    }
    function validNativeDose(data, id) {
      let dose = data.dose;
      let prep = dose.get('preparation', null);
      return data.keys().hasAll(['date', 'exerciseId', 'revision', 'dose']) && data.keys().hasOnly(['date', 'exerciseId', 'revision', 'dose'])
        && calendarDate(data.date) && validWeeklyChoiceId(data.exerciseId) && id == data.date + '_' + data.exerciseId
        && data.revision is int && data.revision >= 1
        && dose is map && dose.keys().hasAll(['id', 'sets', 'value', 'unit', 'restSeconds', 'perSide', 'phase'])
        && dose.keys().hasOnly(['id', 'sets', 'value', 'unit', 'restSeconds', 'perSide', 'phase', 'preparation'])
        && dose.id == data.exerciseId && dose.sets is int && dose.sets in [1, 2, 3, 4, 5]
        && dose.unit in ['reps', 'seconds', 'minutes', 'breaths'] && nativeDoseValue(dose.value, dose.unit == 'minutes' ? 240 : 120)
        && dose.restSeconds is int && dose.restSeconds >= 0 && dose.restSeconds <= 300 && dose.perSide is bool
        && dose.phase in ['warmup', 'skill', 'strength', 'accessory', 'recovery', 'cooldown']
        && (!('preparation' in dose) || (dose.phase in ['strength', 'accessory'] && validNativePreparation(prep)));
    }
    function validPlanningPeriod(data, id) {
      return id.matches('^[A-Za-z0-9_-]{1,120}$')
        && data.keys().hasAll(['from', 'to', 'createdAt', 'weeklyIntent', 'conclusion'])
        && data.keys().hasOnly(['from', 'to', 'dates', 'createdAt', 'weeklyIntent', 'conclusion'])
        && calendarDate(data.from) && calendarDate(data.to)
        && dateTimestamp(data.to) >= dateTimestamp(data.from)
        && dateTimestamp(data.to) - dateTimestamp(data.from) <= duration.value(27, 'd')
        && (!('dates' in data) || (data.dates is list && data.dates.size() >= 1 && data.dates.size() <= 28 && data.dates.toSet().size() == data.dates.size()))
        && data.createdAt == request.time && validWeeklyIntent(data.weeklyIntent)
        && boundedText(data, 'conclusion', 4000);
    }

    match /artifacts/{appId}/users/{userId}/workoutTemplates/{id} {
      allow read: if owner(userId);
      allow create: if owner(userId) && id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasAll(['v', 'name', 'payload', 'revision', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['v', 'name', 'payload', 'revision', 'createdAt', 'updatedAt'])
        && request.resource.data.v == 1 && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 20000
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if owner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'revision', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.updatedAt == request.time;
      allow delete: if owner(userId);
    }
    match /artifacts/{appId}/users/{userId}/workoutNames/{id} {
      allow read, delete: if owner(userId);
      allow create, update: if owner(userId) && id.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll(['v', 'workoutId']) && request.resource.data.keys().hasOnly(['v', 'workoutId'])
        && request.resource.data.v == 1 && request.resource.data.workoutId is string && request.resource.data.workoutId.matches('^[A-Za-z0-9]{20}$');
    }

    match /artifacts/{appId}/users/{userId}/dateSessions/{id} {
      allow create, update: if owner(userId) && validDateSession(request.resource.data, id);
    }
    match /artifacts/{appId}/users/{userId}/dateDoses/{id} {
      allow create, update: if owner(userId) && validNativeDose(request.resource.data, id);
    }
    match /artifacts/{appId}/users/{userId}/planningPeriods/{id} {
      allow create: if owner(userId) && validPlanningPeriod(request.resource.data, id);
    }
    match /artifacts/{appId}/users/{userId}/{group}/{id} {
      allow read, delete: if owner(userId) && group in ['profile', 'progress', 'plans', 'metrics', 'exercises', 'planDays', 'trainingLogs', 'readiness', 'dateSessions', 'dateDoses', 'planningPeriods'];
    }
    // Scope each validator to its collection, keeping unrelated validation out
    // of the expression budget for a complete five-day plan.
    match /artifacts/{appId}/users/{userId}/trainingLogs/{id} {
      allow create, update: if owner(userId) && validTrainingLog(id)
        && (resource == null || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['variant', 'loadKg', 'loadBasis', 'resistanceLabel', 'sets', 'rir', 'quality', 'symptoms', 'nextDay']));
    }
    match /artifacts/{appId}/users/{userId}/readiness/{id} {
      allow create, update: if owner(userId) && validReadiness(request.resource.data, id);
    }
    match /artifacts/{appId}/users/{userId}/metrics/{id} {
      allow create, update: if owner(userId) && validMetrics(request.resource.data, id);
    }
    match /artifacts/{appId}/users/{userId}/profile/{id} {
      allow create, update: if owner(userId) && id == 'settings' && validProfile(request.resource.data);
    }
    match /artifacts/{appId}/users/{userId}/plans/{id} {
      allow create, update: if owner(userId) && weekId(id) && validPlan(request.resource.data, userId, appId, id);
    }
    // Strict daily validation stays within the expression budget. The weekly
    // write verifies both same-commit validation parts before publishing the full plan.
    match /artifacts/{appId}/users/{userId}/planDays/{id} {
      allow create, update: if owner(userId) && validPlanDay(request.resource.data, id);
    }
    match /artifacts/{appId}/users/{userId}/progress/{id} {
      allow create, update: if owner(userId) && weekId(id) && validProgress(request.resource.data);
    }
    match /artifacts/{appId}/users/{userId}/exercises/{id} {
      allow create, update: if owner(userId) && id == 'custom' && request.resource.data.keys().hasOnly(['exercises'])
        && request.resource.data.exercises is map && request.resource.data.exercises.size() <= 500;
    }
    // Public v2 copies are immutable and must be created with their private
    // owner registry in the same commit. Cached owner/header lookups keep a
    // complete 28-day, 254-write copy within the batch document-access budget.
    function publicShareId(id) { return id.matches('^[a-f0-9]{32}$'); }
    function publicShareName(value) {
      return value is string && value.size() >= 1 && value.size() <= 40
        && value.matches('.*[^ ].*') && !value.matches('.*[\n\r\t].*');
    }
    function freshPublicShare(appId, id) {
      let registry = getAfter(/databases/$(database)/documents/artifacts/$(appId)/shareOwners/$(id)).data;
      let header = getAfter(/databases/$(database)/documents/artifacts/$(appId)/sharedPlans/$(id)).data;
      return request.auth != null && publicShareId(id) && registry.uid == request.auth.uid
        && registry.createdAt == request.time && header.createdAt == request.time;
    }
    function publicCatalogId(id) {
      return id is string && (id in ['bulgarian', 'dead_bug']
        || id.matches('^bf_(A(0[1-9]|1[0-5])|B(0[1-9]|1[01])|C(0[1-9]|1[01])|D0[2-9]|E(0[1-9]|10)|F0[1-6]|G0[1-8]|H(0[1-9]|1[0-2])|I0[1-4])$'));
    }
    function publicRoutine(ids) {
      return ids is list && ids.size() <= 8 && ids.toSet().size() == ids.size()
        && (ids.size() < 1 || publicCatalogId(ids[0])) && (ids.size() < 2 || publicCatalogId(ids[1]))
        && (ids.size() < 3 || publicCatalogId(ids[2])) && (ids.size() < 4 || publicCatalogId(ids[3]))
        && (ids.size() < 5 || publicCatalogId(ids[4])) && (ids.size() < 6 || publicCatalogId(ids[5]))
        && (ids.size() < 7 || publicCatalogId(ids[6])) && (ids.size() < 8 || publicCatalogId(ids[7]));
    }
    function publicNumericValue(value, maximum) {
      let parts = value.split('[–-]');
      let low = int(parts[0]);
      let high = parts.size() == 2 ? int(parts[1]) : low;
      return value is string && value.matches('^[0-9]{1,3}([–-][0-9]{1,3})?$')
        && low >= 1 && high >= low && high <= maximum;
    }
    function publicPreparation(prep) {
      return prep is map && prep.keys().hasAll(['sets', 'value', 'unit', 'restSeconds', 'perSide'])
        && prep.keys().hasOnly(['sets', 'value', 'unit', 'restSeconds', 'perSide'])
        && prep.sets is int && prep.sets in [1, 2] && prep.unit in ['reps', 'seconds', 'breaths']
        && publicNumericValue(prep.value, prep.unit == 'seconds' ? 30 : 8)
        && prep.restSeconds is int && prep.restSeconds >= 0 && prep.restSeconds <= 120 && prep.perSide is bool;
    }
    function publicJumpDose(dose) {
      let parts = dose.value.split('[–-]');
      let high = int(parts[parts.size() - 1]);
      return !dose.id.matches('^bf_E(0[2-9]|10)$')
        || (dose.unit == 'reps' && dose.sets * high * (dose.perSide ? 2 : 1) <= 24);
    }
    function publicSequenceDose(dose) {
      return !(dose.id in ['bf_A12', 'bf_A13'])
        || (dose.sets == 1 && dose.value == (dose.id == 'bf_A12' ? '6' : '10')
          && dose.unit == 'minutes' && dose.perSide == false && dose.restSeconds == 0 && !('preparation' in dose));
    }
    function publicDose(dose) {
      return dose is map && dose.keys().hasAll(['id', 'phase', 'sets', 'value', 'unit', 'restSeconds', 'perSide'])
        && dose.keys().hasOnly(['id', 'phase', 'sets', 'value', 'unit', 'restSeconds', 'perSide', 'preparation'])
        && publicCatalogId(dose.id) && dose.phase in ['warmup', 'skill', 'strength', 'accessory', 'recovery', 'cooldown']
        && (!dose.id.matches('^bf_[EFG].*$') || dose.phase == 'skill')
        && dose.sets is int && dose.sets in [1, 2, 3, 4, 5]
        && dose.unit in ['reps', 'seconds', 'minutes', 'breaths']
        && publicNumericValue(dose.value, dose.unit == 'seconds' ? 600 : (dose.unit == 'minutes' ? 10 : (dose.unit == 'breaths' ? 30 : 100)))
        && dose.restSeconds is int && dose.restSeconds >= 0 && dose.restSeconds <= 300 && dose.perSide is bool
        && (!('preparation' in dose) || (dose.phase in ['strength', 'accessory'] && publicPreparation(dose.preparation)))
        && publicJumpDose(dose) && publicSequenceDose(dose);
    }
    match /artifacts/{appId}/shareOwners/{shareId} {
      allow get: if owner(resource.data.uid);
      allow list, update, delete: if false;
      allow create: if request.auth != null && publicShareId(shareId)
        && request.resource.data.keys().hasAll(['uid', 'createdAt']) && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/sharedPlans/$(shareId)).data.createdAt == request.time;
    }
    match /artifacts/{appId}/sharedPlans/{shareId} {
      allow get: if publicShareId(shareId);
      allow list, update, delete: if false;
      allow create: if freshPublicShare(appId, shareId)
        && request.resource.data.keys().hasAll(['v', 'name', 'dayCount', 'createdAt'])
        && request.resource.data.keys().hasOnly(['v', 'name', 'dayCount', 'createdAt'])
        && request.resource.data.v == 2 && publicShareName(request.resource.data.name)
        && request.resource.data.dayCount is int && request.resource.data.dayCount >= 1 && request.resource.data.dayCount <= 28;
      match /days/{dayId} {
        allow get: if publicShareId(shareId) && dayId.matches('^(0|[1-9]|1[0-9]|2[0-7])$');
        allow list: if publicShareId(shareId) && request.query.limit != null && request.query.limit <= 28;
        allow update, delete: if false;
        allow create: if freshPublicShare(appId, shareId) && dayId.matches('^(0|[1-9]|1[0-9]|2[0-7])$')
          && request.resource.data.keys().hasAll(['index', 'name', 'offset', 'routine', 'sessionType'])
          && request.resource.data.keys().hasOnly(['index', 'name', 'offset', 'routine', 'sessionType'])
          && request.resource.data.index is int && dayId == string(request.resource.data.index)
          && request.resource.data.index < getAfter(/databases/$(database)/documents/artifacts/$(appId)/sharedPlans/$(shareId)).data.dayCount
          && publicShareName(request.resource.data.name)
          && request.resource.data.offset is int && request.resource.data.offset >= 0 && request.resource.data.offset <= 27
          && (dayId != '0' || request.resource.data.offset == 0) && publicRoutine(request.resource.data.routine)
          && request.resource.data.sessionType in ['training', 'recovery', 'rest']
          && ((request.resource.data.sessionType == 'rest') == (request.resource.data.routine.size() == 0));
        match /doses/{slot} {
          allow get: if publicShareId(shareId) && dayId.matches('^(0|[1-9]|1[0-9]|2[0-7])$') && slot.matches('^[0-7]$');
          allow list: if publicShareId(shareId) && dayId.matches('^(0|[1-9]|1[0-9]|2[0-7])$')
            && request.query.limit != null && request.query.limit <= 8;
          allow update, delete: if false;
          allow create: if freshPublicShare(appId, shareId) && dayId.matches('^(0|[1-9]|1[0-9]|2[0-7])$') && slot.matches('^[0-7]$')
            && int(dayId) < getAfter(/databases/$(database)/documents/artifacts/$(appId)/sharedPlans/$(shareId)).data.dayCount
            && publicDose(request.resource.data);
        }
      }
    }
  }
}
