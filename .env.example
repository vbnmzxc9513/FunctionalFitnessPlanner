# Public Firebase web configuration. Never put a personal Gemini key here.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_APP_ID=my-fitness-app-yp

# Local emulator use: set a demo project ID to avoid production writes.
VITE_USE_FIREBASE_EMULATORS=false
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080

# GitHub Pages defaults are used when omitted. Cloudflare uses CF_PAGES=1.
# VITE_BASE_PATH=/FunctionalFitnessPlanner/
# VITE_SITE_URL=https://vbnmzxc9513.github.io/FunctionalFitnessPlanner/
